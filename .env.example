NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only. Required for the admin panel, lounge rate limiting and XP writes. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Server-only. Used for AI moderation; without it messages fall back to manual review.
GROQ_API_KEY=your_groq_api_key
# Optional: the account with this email gets the OWNER badge
OWNER_EMAIL=
